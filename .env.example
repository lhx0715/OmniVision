# ===== 数据库配置 =====
# Supabase 连接字符串（从 Supabase 控制台获取）
# 格式: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=

# ===== 搜索 API（多源并行，无 key 自动降级跳过）=====
# 大会场景推荐：配置 SearXNG（自建，无限免费）作为主力，其余作补充/兜底。
# 六维并行搜索会同时调用所有已配置的源；配额熔断中间件会在某源被限流时自动跳过。

# SearXNG（自建元搜索引擎，完全免费·无限调用，大会主力源）
# 部署：cd docker/searxng && docker compose up -d
# 指向自建实例地址，无需 API key
SEARXNG_URL=http://localhost:8080

# Serper（Google SERP，2500 次/月免费）: https://serper.dev
SERPER_API_KEY=

# Tavily（自带 AI 摘要 + images，1000 次/月；唯一图片源）: https://tavily.com
TAVILY_API_KEY=

# ===== 大模型 API =====
# OpenAI 兼容接口（支持 OpenAI / DeepSeek / 月之暗面 / 通义千问等）
# 只需修改 LLM_BASE_URL 和 LLM_MODEL 即可切换模型
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ===== 可选：LLM 意图分类（独立模型，可用更便宜/更快的）=====
# 不填则用关键词规则做快速分类
LLM_ROUTER_MODEL=

# ===== PRD-01：多信源适配器（可选，无 key 自动降级跳过）=====

# Exa（语义/研究检索，neural search）: https://exa.ai
# 无 key 时自动跳过，不影响主流程
EXA_API_KEY=

# GitHub Token（提升代码/产品热度源的限流额度）: https://github.com/settings/tokens
# 无 token 时匿名调用（10 次/分钟），仍可用
GITHUB_TOKEN=

# DuckDuckGo：完全免费，无需配置任何 key，自动启用作为兜底源
# （基于 Instant Answer API，结果覆盖有限，仅作最后一道防线）

# Openverse：完全免费，无需配置任何 key，自动启用作为图片源
# （聚合 Wikimedia/Flickr 等数亿张 CC 授权图片，供影像档案 Gallery）
